[Match]
Name=ts-source

[Link]
RequiredForOnline=no

[Network]
DHCP=yes
IPv6AcceptRA=yes
IPv6PrivacyExtensions=no
LinkLocalAddressing=ipv6

[DHCPv4]
ClientIdentifier=mac
SendHostname=no
UseHostname=no
UseDNS=no
UseDomains=no
UseNTP=no
UseMTU=no
SendDecline=yes
RouteTable=2053
RouteMetric=100

[DHCPv6]
UseDNS=no
UseDomains=no
UseNTP=no

[IPv6AcceptRA]
UseDNS=no
UseDomains=no
RouteTable=2053
RouteMetric=100

# Keep traffic from falling back to the ordinary interface when a lease expires.
[Route]
Destination=0.0.0.0/0
Type=unreachable
Table=2053
Metric=42760

[Route]
Destination=::/0
Type=unreachable
Table=2053
Metric=42760
